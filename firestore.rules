rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: tek hesap; e-posta doğrulanmış olmalı (Google girişinde hep true) — e-posta/şifre ile
    // aynı adresi doğrulamadan kullanan bir hesap admin sayılmaz.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "berkayer032@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // Collection-group query için (members.html reply count sayımı)
    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    // users/{uid}.email profil/üye listesinde admin rozetini belirler: kullanıcı yalnız kendi
    // oturum e-postasını (ya da boş / değişmemiş değeri) yazabilir; admin adresini yalnız admin.
    function userEmailOk() {
      let e = request.resource.data.get('email', null);
      return e == null || e == '' || (
        e is string &&
        (e == request.auth.token.get('email', null) ||
          (resource != null && e == resource.data.get('email', null))) &&
        (e.lower() != "berkayer032@gmail.com" || isAdmin())
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      // Ünvan (title) yalnız admin yazar (profile.html ünvan seçici)
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid &&
          !('title' in request.resource.data) &&
          userEmailOk())
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']) &&
          userEmailOk())
      );
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // Kişisel iletişim bilgisi (telefon): yalnız sahibi ve admin — users/{uid} herkese açık profil
    match /users/{uid}/private/{docId} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /users/{uid}/userReplies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/beats/{beatId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/presets/{presetId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ableton Lab: Mixing (BE·CONSOLE 03) ve Mastering (BE·MASTER 05) kullanıcı presetleri
    match /users/{uid}/mixPresets/{presetId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/masterPresets/{presetId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ableton Lab: Arrangement (BE·ARRANGER 04) kayıtlı aranjmanlar
    match /users/{uid}/arrangements/{arrId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /testimonials/{id} {
      allow read: if true;
      // Alanlar index.html submitComment() ile birebir (form: ad ≤ 40, yorum ≤ 300 karakter)
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // İstemcinin yazdığı bildirimler: DM / collab (profile.html), yeni konu (new-post.html),
      // konuya yanıt (post.html). Ders onayı (lesson_confirm) yalnız Cloud Functions yazar.
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['text', 'read', 'fromUid', 'fromName', 'type', 'postId', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.get('read', false) == false &&
        request.resource.data.get('type', 'none') in ['none', 'collab', 'collab_accepted'] &&
        request.resource.data.get('fromName', '') is string &&
        request.resource.data.get('fromName', '').size() <= 100 &&
        (!('postId' in request.resource.data) ||
          (request.resource.data.postId is string && request.resource.data.postId.matches('^[A-Za-z0-9]{1,64}$'))) &&
        request.resource.data.createdAt == request.time;
    }

    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
    }

    match /forum/{postId} {
      allow read: if true;
      // Alanlar new-post.html submitPost() ile birebir; admin rozeti (authorIsAdmin) ve
      // sabitleme (pinned) yalnız admin; yanıt sayacı 0'dan başlar
      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid &&
        (isAdmin() || (
          request.resource.data.keys().hasOnly(['title', 'text', 'category', 'authorName', 'authorId',
            'authorIsAdmin', 'authorPhotoURL', 'createdAt', 'replyCount', 'solved']) &&
          request.resource.data.get('authorIsAdmin', false) == false &&
          request.resource.data.get('replyCount', 0) == 0
        ));
      allow update: if request.auth != null && (
        isAdmin() ||
        // Beğeni: yalnız kendi uid'ini ekler/çıkarır, sayaç listeyle aynı miktarda değişir
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','likeCount']) &&
          request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet())
            .union(resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()))
            .hasOnly([request.auth.uid]) &&
          request.resource.data.likeCount - resource.data.get('likeCount', 0) ==
            request.resource.data.likedBy.size() - resource.data.get('likedBy', []).size()) ||
        (request.auth.uid == resource.data.authorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])) ||
        (request.auth.uid == resource.data.authorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved'])) ||
        // Yanıt sayacı: yalnız ±1 (yanıt ekleme / silme)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
          (request.resource.data.replyCount - resource.data.get('replyCount', 0)) in [1, -1])
      );
      allow delete: if request.auth != null && isAdmin();

      match /replies/{replyId} {
        allow read: if true;
        // Kendi adına yanıt; ⚡ admin rozeti (isAdmin) yalnız admin yazabilir
        allow create: if request.auth != null &&
          request.resource.data.authorId == request.auth.uid &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isAdmin());
        allow update: if request.auth != null && (
          isAdmin() ||
          (request.auth.uid == resource.data.authorId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt']))
        );
        allow delete: if request.auth != null && (
          isAdmin() ||
          request.auth.uid == resource.data.authorId
        );
      }
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if request.auth != null &&
        isAdmin();

      match /messages/{msgId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          chatId.matches('.*' + request.auth.uid + '.*')
        );
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.fromUid &&
          chatId.matches('.*' + request.auth.uid + '.*');
        allow update: if request.auth != null &&
          chatId.matches('.*' + request.auth.uid + '.*') &&
          resource.data.type == 'collab_request' &&
          request.auth.uid != resource.data.fromUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if request.auth != null &&
          isAdmin();
      }
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    match /userSettings/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ── Booking system ──
    match /access_codes/{codeId} {
      allow read: if isAdmin();
      allow write: if request.auth != null && isAdmin();
    }

    match /reservations/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
      allow create, delete: if request.auth != null &&
        isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && (
          // Note-only update
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note']) ||
          // Payment request
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment_pending']) &&
            request.resource.data.payment_pending == true) ||
          // Rules acceptance (write-once: must not already be set). rules_accepted_at
          // stays the write-once gate; rules_accepted_detail (per-rule timestamps) and
          // rules_version ride along in the same one-time write.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rules_accepted_at', 'rules_accepted_detail', 'rules_version']) &&
            !('rules_accepted_at' in resource.data)) ||
          // Kural güncellemesi (48 saat itiraz + Zoom kanıtı) onayı — tek seferlik, sunucu zamanı
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rules_v2_accepted_at']) &&
            !('rules_v2_accepted_at' in resource.data) &&
            request.resource.data.rules_v2_accepted_at == request.time) ||
          // Student adds/updates own WhatsApp number. Format kontrolü:
          // 5XXXXXXXXX | 05XXXXXXXXX | 905XXXXXXXXX (Türk hat formatları)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['student_phone']) &&
            request.resource.data.student_phone is string &&
            request.resource.data.student_phone.matches('^(5[0-9]{9}|05[0-9]{9}|905[0-9]{9})$'))
          // Lessons: sadece admin güncelleyebilir
        ))
      );
    }

    // Ders kanıtı: Zoom katılımcı listesi (lessonAttendanceSync yazar) — yalnız admin
    match /lesson_attendance/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin bildirim sayaçları (notifyAdminOnNewRequest) — yalnız fonksiyon yazar
    match /rate_limits/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // WhatsApp conversations — admin-only (Cloud Functions bypass rules)
    match /whatsapp_conversations/{phone} {
      allow read, write: if request.auth != null &&
        isAdmin();
      match /messages/{msgId} {
        allow read, write: if request.auth != null &&
          isAdmin();
      }
    }

    // Dolu saatleri yalnız admin (panel) ve Cloud Functions (Admin SDK) yazar; öğrenci istemcisi yazmaz
    match /booked_slots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        isAdmin();
    }

    match /lesson_requests/{reqId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.from_uid ||
        isAdmin()
      );
      // from_email oturum e-postasıyla aynı olmalı (e-postalarda/WhatsApp'ta başkası adına talep olmasın);
      // deneme talebi küçük harfe çevirip yazdığı için karşılaştırma büyük/küçük harf duyarsız
      allow create: if request.auth != null &&
        request.resource.data.from_uid == request.auth.uid &&
        request.resource.data.get('from_email', '') is string &&
        request.resource.data.get('from_email', '').lower() == request.auth.token.get('email', '').lower();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && (
        // Öğrenci reddedilen talebini (yeniden deneme) ya da bekleyen talebini ("Talebi geri çek") silebilir
        (request.auth.uid == resource.data.from_uid && resource.data.status in ['rejected', 'pending']) ||
        isAdmin()
      );
    }

    // settings/zoom (Zoom linki) yalnız admin ile ödemesi onaylı ya da deneme dersi olan öğrenciye
    // açık; diğer ayarlar (müsaitlik, kampanyalar) giriş yapan herkese.
    function canReadZoom() {
      let resPath = /databases/$(database)/documents/reservations/$(request.auth.uid);
      return exists(resPath) && (
        get(resPath).data.get('payment_confirmed', false) == true ||
        get(resPath).data.get('lesson_type', '') == 'trial');
    }
    match /settings/{docId} {
      allow read: if request.auth != null && (docId != 'zoom' || isAdmin() || canReadZoom());
      allow write: if request.auth != null && isAdmin();
    }

    match /booking_access_requests/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
      // Erişim talebi akışı kaldırıldı: istemci artık oluşturmaz (eski belgeler okunur/silinir).
      // Durumu (onay/red) yalnız admin değiştirir; öğrenci kendi talebini yalnız silebilir
      allow update: if isAdmin();
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // UUID anahtarlı köprü: anahtarı bilen tek belgeyi okur (get); koleksiyon LİSTELENEMEZ
    // (belgelerde Google ID token + e-posta var). Belge yalnız yazıldıktan sonraki 10 dakika
    // okunabilir (createdAt = sunucu saati). Admin hesabı köprüye belirteç yazamaz.
    // Yazma/silme yalnız belgenin sahibine; alanlar app-bridge.html ile birebir.
    function bridgeWriteOk(key) {
      return request.auth != null &&
        key.matches('^[A-Za-z0-9_-]{16,128}$') &&
        request.auth.token.get('email', '').lower() != "berkayer032@gmail.com" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.get('email', null) &&
        request.resource.data.keys().hasOnly(['googleIdToken', 'uid', 'email', 'displayName', 'photoURL', 'expiresAt', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'm');
    }
    match /app_bridge/{key} {
      // Henüz yazılmamış belge (uygulama bekler/yoklar) "yok" döner, izin hatası değil
      allow get: if resource == null || (
        resource.data.get('createdAt', null) is timestamp &&
        request.time < resource.data.createdAt + duration.value(10, 'm'));
      allow list: if false;
      allow create: if bridgeWriteOk(key);
      allow update: if bridgeWriteOk(key) && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Seviye belirleme sınavı — öğrenci kendi sonucunu bir kez yazar ve görür,
    // admin hepsini görür; tekrar çözüm ancak admin sonucu silerse mümkün.
    match /placement_tests/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
      // Alanlar booking.html ptSubmit() ile birebir; sayılar tam sayı ve aralıkta, metinler kısa
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(['uid', 'student_name', 'student_email', 'score', 'correct',
          'unknown', 'total', 'level_key', 'level_tr', 'level_en', 'answers', 'quiz_version', 'completed_at']) &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.correct is int &&
        request.resource.data.correct >= 0 && request.resource.data.correct <= 100 &&
        request.resource.data.unknown is int &&
        request.resource.data.unknown >= 0 && request.resource.data.unknown <= 100 &&
        request.resource.data.total is int &&
        request.resource.data.total >= 1 && request.resource.data.total <= 100 &&
        request.resource.data.quiz_version is int &&
        request.resource.data.quiz_version >= 1 && request.resource.data.quiz_version <= 1000 &&
        request.resource.data.level_key in ['zero', 'beginner', 'intermediate', 'advanced'] &&
        request.resource.data.level_tr is string && request.resource.data.level_tr.size() <= 40 &&
        request.resource.data.level_en is string && request.resource.data.level_en.size() <= 40 &&
        request.resource.data.get('student_name', '') is string &&
        request.resource.data.get('student_name', '').size() <= 120 &&
        request.resource.data.get('student_email', '') is string &&
        request.resource.data.get('student_email', '').size() <= 200 &&
        request.resource.data.answers is map &&
        request.resource.data.answers.size() <= 100 &&
        request.resource.data.completed_at == request.time;
      allow update, delete: if request.auth != null &&
        isAdmin();
    }

    // Site içi asistan: öğrencinin "Berkay'a ilet" dediği soru — öğrenci yalnız kendi adına,
    // yanıtlanmamış olarak oluşturur ve yalnız kendininkini okur; admin hepsini okur, yanıtlar, siler.
    match /assistant_questions/{qId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        isAdmin()
      );
      // Belge id'si istemcinin .doc() otomatik id'si olmalı (20 harf/rakam) — admin kartı bu id'yi kullanır
      allow create: if request.auth != null &&
        qId.matches('^[A-Za-z0-9]{20}$') &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.answered == false &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('name', '').size() <= 80 &&
        request.resource.data.get('state', '') is string &&
        request.resource.data.get('state', '').size() <= 20 &&
        request.resource.data.get('lang', 'tr') in ['tr', 'en'] &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'state', 'lang', 'answered', 'created_at']) &&
        request.resource.data.created_at == request.time &&
        // aynı toplu yazımda assistant_limits/{uid} şimdiye çekilmiş olmalı (30 sn sınırı orada)
        getAfter(/databases/$(database)/documents/assistant_limits/$(request.auth.uid)).data.last_at == request.time;
      allow update, delete: if isAdmin();
    }

    // Öğrenci başına "Berkay'a ilet" sınırı: her iletme bu belgeyi sunucu saatine çeker; önceki
    // iletmeden 30 sn geçmeden güncellenemez, öğrenci silemez (sınır sıfırlanamaz)
    match /assistant_limits/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['last_at']) &&
        request.resource.data.last_at == request.time;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['last_at']) &&
        request.resource.data.last_at == request.time &&
        request.time > resource.data.last_at + duration.value(30, 's');
      allow delete: if isAdmin();
    }

    // Asistanın öğrendiği cevaplar (admin yazar, giriş yapmış herkes okur; asistan canlı birleştirir)
    match /assistant_faq/{faqId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /lesson_questions/{qId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        isAdmin()
      );

      match /answers/{aId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/lesson_questions/$(qId)).data.uid
        );
        allow create: if request.auth != null && (
          isAdmin() ||
          (request.resource.data.fromAdmin == false &&
            request.auth.uid == get(/databases/$(database)/documents/lesson_questions/$(qId)).data.uid)
        );
      }
    }

  }
}
